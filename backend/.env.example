# Copy this file to backend/.env and fill values locally.
# Never commit backend/.env.

# Flyway migration connection. This must use stog_migrator, never stog_app.
# It targets the isolated stog_canonical_dev database in the local PostgreSQL
# cluster on localhost:5432; never use the legacy local stog database or Cloud SQL.
MIGRATOR_DB_URL=jdbc:postgresql://localhost:5432/stog_canonical_dev
MIGRATOR_DB_USERNAME=stog_migrator
MIGRATOR_DB_PASSWORD=3631

# Spring Boot runtime database connection. This must use stog_app.
# Set credentials only in the ignored backend/.env after the administrator has
# provisioned the isolated database and role boundary.
DB_URL=jdbc:postgresql://localhost:5432/stog_canonical_dev
DB_USERNAME=stog_app
DB_PASSWORD=
LOCAL_DB_PASSWORD=
# Cloud SQL verification through Auth Proxy on localhost:5433.
# Do not activate the cloud profile during normal local development.
CLOUD_DB_URL=jdbc:postgresql://localhost:5433/stog_0
CLOUD_DB_USERNAME=Stobee_0
CLOUD_DB_PASSWORD=

# STOG Access/Refresh JWT signing secret. Use a long random value.
JWT_SECRET=

# Google Credential Manager server client ID and backend token audience.
GOOGLE_WEB_CLIENT_ID=

# Google Places API (New): Text/Nearby search and Place Details.
# Backend-only key. Use API restrictions, not an Android application key.
# Field masks are required by the client.
GOOGLE_PLACES_API_KEY=

# Google Routes API: walking and public-transit itinerary calculations.
# Backend-only key. Use API restrictions, not an Android application key.
# Never inject either Google API key into the APK.
GOOGLE_ROUTES_API_KEY=

# Cloud Storage signed upload configuration. The gcs-write profile is explicit
# and must not be enabled until Cloud Storage write approval exists.
GCS_BUCKET=
GCS_SIGNED_URL_TTL=

# Naver Login OAuth: authorization code exchange and profile lookup.
# Client Secret is backend-only and must never enter the APK.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
STOG_APP_LINK_URI=

# KMA short-term forecast API:
# https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_SHORT_TERM_FORECAST_SERVICE_KEY=

# Small Business Commercial Area Information API:
# https://apis.data.go.kr/B553077/api/open/sdsc2
SME_COMMERCIAL_AREA_SERVICE_KEY=

# Korea Tourism Organization photo gallery API:
# https://apis.data.go.kr/B551011/PhotoGalleryService1
TOUR_PHOTO_SERVICE_KEY=

# Korea Tourism Organization Korean tourism information API:
# https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
